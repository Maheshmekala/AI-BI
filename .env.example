# ── LLM API Keys (at least one required) ──
# Get your keys from each provider's console:

# OpenAI      → https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key

# Anthropic   → https://console.anthropic.com/ (Claude)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Google      → https://aistudio.google.com/ (Gemini)
GOOGLE_API_KEY=your-google-gemini-key

# Groq        → https://console.groq.com/keys  (fast, free tier available)
GROQ_API_KEY=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

# DeepSeek    → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-key

# xAI / Grok  → https://console.x.ai/
XAI_API_KEY=your-xai-grok-key

# Together AI → https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=your-together-key

# OpenRouter  → https://openrouter.ai/keys  (200+ models, single API)
OPENROUTER_API_KEY=sk-or-your-openrouter-key

# For local models via Ollama (no API key needed)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_DEFAULT_MODEL=llama3.1

# ── Database connections (optional, for SQL sources) ──
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=mydb
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=your-password

# ── App Configuration ──
APP_NAME=Instant BI
APP_THEME=light
MAX_UPLOAD_SIZE_MB=200
CACHE_TTL_SECONDS=3600
